# Git ignore documentation:
# https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies and package-manager state
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend - Expo, Metro, and generated builds
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
frontend/.metro-health-check*
frontend/ios/
frontend/android/
frontend/.kotlin/

# Native signing credentials and merge artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Environment files and local secrets
.env
.env.*
!.env.example
frontend/.env
backend/.env

# AI snapshots, temporary exports, and test artifacts
/tmp-*
tmp/
*.tmp
*.tmp.*
*.snapshot.png
*.test.png
*.playwright.png
*-snapshot.png
*-screenshot.png
.codex/
.agents/

# Logs, coverage, and compiler caches
*.log
coverage/
backend/logs/
backend/coverage/
*.tsbuildinfo

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# IDE and editor settings
.idea/
.vscode/*

# Project-specific generated output
output/
docs/report-qa/
docs/Raphiphat-Navigation-Report-QA.pdf
app-example
